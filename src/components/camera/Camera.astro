---
import {
  TAKE_BUTTON_ID,
  SHARE_BUTTON_ID,
  SHARE_DEMO_ID,
  IMAGE_ID,
} from "../ids.ts";
---

<div class="w-full min-h-[600px] flex flex-col items-center justify-start bg-base-100 pt-8 pb-24 px-4">
  <h1 class="text-2xl font-bold text-center mb-4">Camera & Share</h1>
  <img class="w-full max-h-[300px] mb-4 object-contain rounded-lg shadow" id={IMAGE_ID} />
  <div class="flex w-full gap-3 mb-4">
    <button class="btn btn-primary flex-1" id={TAKE_BUTTON_ID}>Take picture</button>
    <button class="btn btn-outline flex-1" id={SHARE_BUTTON_ID}>Share picture</button>
  </div>
  <button class="btn btn-primary w-full mb-2" id={SHARE_DEMO_ID}>Share demo</button>
</div>

<script src="./index.ts"></script>
