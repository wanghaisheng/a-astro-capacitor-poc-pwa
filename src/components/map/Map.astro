---
import Leaflet from "./Leaflet.astro";

const markersLocation: [string, number, number][] = [
  ["CentralWorld", 13.746, 100.5393],
  ["MBK Center", 13.7444, 100.5302],
  ["Siam Paragon", 13.7463, 100.5347],
  ["Terminal 21", 13.7373, 100.5609],
  ["Emporium and EmQuartier", 13.7296, 100.5692],
];
---

<div class="w-full min-h-[600px] flex flex-col items-center justify-start bg-base-100 pt-8 pb-24 px-4">
  <h2 class="text-2xl font-bold mb-2 text-center">Leaflet Map</h2>
  <h3 class="text-lg font-semibold mb-2 text-center">Your current location</h3>
  <div id="current-map" class="w-full mb-4">
    <div class="flex justify-between text-sm mb-1">
      <span>Longitude:</span>
      <span id="latitude"></span>
    </div>
    <div class="flex justify-between text-sm mb-2">
      <span>Latitude:</span>
      <span id="longitude"></span>
    </div>
    <div id="user-map" class="h-[200px] w-full rounded-lg shadow"></div>
  </div>
  <div class="w-full">
    <h3 class="text-lg font-semibold mb-2 text-center">Malls in Bangkok</h3>
    <Leaflet
      container="mall-map-container"
      latitude={markersLocation[0][1]}
      longitude={markersLocation[0][2]}
      zoom={13}
      tileLayer="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
      attribution="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"
      containerstyle="height: 200px; width: 100%; border-radius: 0.5rem; box-shadow: 0 1px 8px rgba(0,0,0,0.07);"
      locations={markersLocation}
    />
  </div>
</div>

<script src="./map.ts"></script>
