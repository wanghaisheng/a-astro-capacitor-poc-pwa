---
title: "Home"
---

<!-- Sleep Track App Home Page using DaisyUI and Tailwind CSS -->
<div class="w-full min-h-[600px] flex flex-col items-center justify-center bg-base-100">
  <div class="w-full max-w-md p-6 bg-white rounded-lg shadow-lg mt-8">
    <h1 class="text-3xl font-bold text-center mb-4">Sleep Tracker</h1>
    <p class="text-center text-gray-500 mb-6">Track your sleep and improve your health</p>
    <div class="stats shadow mb-6">
      <div class="stat">
        <div class="stat-title">Last Night's Sleep</div>
        <div class="stat-value text-primary">7h 45m</div>
        <div class="stat-desc">Better than 65% of users</div>
      </div>
      <div class="stat">
        <div class="stat-title">Sleep Goal</div>
        <div class="stat-value text-secondary">8h</div>
        <div class="stat-desc">Keep it up!</div>
      </div>
    </div>
    <button class="btn btn-primary w-full mb-4">Start Sleep Tracking</button>
    <div class="divider">OR</div>
    <button class="btn btn-outline w-full">View Sleep History</button>
  </div>
  <div class="mt-8 text-center text-xs text-gray-400">Powered by DaisyUI & Tailwind CSS</div>
</div>
